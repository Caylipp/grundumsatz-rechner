---
import { BODY_FAT_RANGES, formatters, messages, palLevels, sportLevels, type Locale, type SkinfoldSite } from '@grundumsatz/core';
import { UI_TEXT } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI_TEXT[locale];
const F = t.form;
const core = messages(locale);
const fmt = formatters(locale);

const bfSources = (['bia', 'bia8', 'visual', 'caliper', 'bodpod', 'dexa'] as const).map((id) => ({ id, label: core.sources[id], range: BODY_FAT_RANGES[id] }));
const sites: SkinfoldSite[] = ['chest', 'abdomen', 'thigh', 'triceps', 'suprailiac', 'subscapular', 'midaxillary', 'biceps'];
---

<section class="calc wrap" aria-label={t.nav.calculator}>
  <form id="calc-form" class="inputs" novalidate autocomplete="off">
    <!-- 1 Basis -->
    <fieldset class="card group">
      <legend class="group-head">
        <span class="step-no">1</span>
        <span class="group-title">{F.basics.title} <span class="req">{F.required}</span></span>
      </legend>
      <div class="group-body">
        <div class="field">
          <span class="label" id="sex-label">{F.basics.sex}</span>
          <div class="seg" role="radiogroup" aria-labelledby="sex-label">
            <label><input type="radio" name="sex" value="female" /><span>{F.basics.female}</span></label>
            <label><input type="radio" name="sex" value="male" /><span>{F.basics.male}</span></label>
          </div>
          <p class="hint small muted">{F.basics.sexHint}</p>
          <p class="err" data-error-for="sex"></p>
        </div>
        <div class="row3">
          <label class="field">
            <span class="label">{F.basics.age}</span>
            <span class="unit-input"><input name="age" inputmode="numeric" placeholder="34" /><span>{F.basics.years}</span></span>
            <span class="err" data-error-for="age"></span>
          </label>
          <label class="field">
            <span class="label">{F.basics.height}</span>
            <span class="unit-input"><input name="height" inputmode="decimal" placeholder="175" /><span>cm</span></span>
            <span class="err" data-error-for="heightCm"></span>
          </label>
          <label class="field">
            <span class="label">{F.basics.weight}</span>
            <span class="unit-input"><input name="weight" inputmode="decimal" placeholder={fmt.dec1(72.5)} /><span>kg</span></span>
            <span class="err" data-error-for="weightKg"></span>
          </label>
        </div>
      </div>
    </fieldset>

    <p class="more-intro muted small" set:html={F.optionalHtml} />

    <!-- 2 Umfänge -->
    <details class="card group" data-group="circumferences">
      <summary class="group-head">
        <span class="step-no">2</span>
        <span class="group-title">{F.circ.title}</span>
        <span class="gain" data-gain="circumferences"></span>
        <span class="done-dot" data-done="circumferences" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <p class="muted small" set:html={F.circ.introHtml} />
        <div class="row3">
          <label class="field">
            <span class="label">{F.circ.waist}</span>
            <span class="unit-input"><input name="waist" inputmode="decimal" placeholder="84" /><span>cm</span></span>
            <span class="err" data-error-for="waistCm"></span>
          </label>
          <label class="field">
            <span class="label">{F.circ.neck}</span>
            <span class="unit-input"><input name="neck" inputmode="decimal" placeholder="37" /><span>cm</span></span>
            <span class="err" data-error-for="neckCm"></span>
          </label>
          <label class="field" data-only="female">
            <span class="label">{F.circ.hip}</span>
            <span class="unit-input"><input name="hip" inputmode="decimal" placeholder="98" /><span>cm</span></span>
            <span class="err" data-error-for="hipCm"></span>
          </label>
        </div>
        <details class="howto small">
          <summary>{F.circ.howto}</summary>
          <ul>
            <li set:html={F.circ.howtoWaistHtml} />
            <li set:html={F.circ.howtoNeckHtml} />
            <li data-only="female" set:html={F.circ.howtoHipHtml} />
            <li>{F.circ.howtoGeneral}</li>
          </ul>
        </details>
      </div>
    </details>

    <!-- 3 Hautfalten -->
    <details class="card group" data-group="caliper">
      <summary class="group-head">
        <span class="step-no">3</span>
        <span class="group-title">{F.caliper.title}</span>
        <span class="gain" data-gain="caliper"></span>
        <span class="done-dot" data-done="caliper3" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <p class="muted small" set:html={F.caliper.introHtml} />
        <label class="field">
          <span class="label">{F.caliper.measurer}</span>
          <select name="measurer">
            <option value="self">{F.caliper.self}</option>
            <option value="trained">{F.caliper.trained}</option>
          </select>
        </label>
        <div class="caliper-status" id="caliper-status" aria-live="polite">
          <div class="cs-row"><span class="cs-bar"><span id="cs3"></span></span><span class="small" id="cs3-text"></span></div>
          <div class="cs-row"><span class="cs-bar"><span id="cs7"></span></span><span class="small" id="cs7-text"></span></div>
        </div>
        <div class="sites">
          {
            sites.map((site) => (
              <label class="field site" data-site={site}>
                <span class="label">
                  {F.caliper.sites[site].label} <span class="tags" data-tags />
                </span>
                <span class="unit-input">
                  <input name={`sf_${site}`} inputmode="decimal" placeholder="mm" />
                  <span>mm</span>
                </span>
                <span class="site-howto">{F.caliper.sites[site].howto}</span>
                <span class="err" data-error-for={`skinfold.${site}`} />
              </label>
            ))
          }
        </div>
        <details class="howto small">
          <summary>{F.caliper.howto}</summary>
          <p>{F.caliper.howtoGeneral}</p>
        </details>
      </div>
    </details>

    <!-- 4 Körperfett -->
    <details class="card group" data-group="bodyfat">
      <summary class="group-head">
        <span class="step-no">4</span>
        <span class="group-title">{F.bodyfat.title}</span>
        <span class="gain" data-gain="bodyfat"></span>
        <span class="done-dot" data-done="bodyfat" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <p class="muted small">{F.bodyfat.intro}</p>
        <div class="row2">
          <label class="field">
            <span class="label">{F.bodyfat.percent}</span>
            <span class="unit-input"><input name="bf" inputmode="decimal" placeholder="22" /><span>%</span></span>
            <span class="err" data-error-for="bodyFat"></span>
          </label>
          <label class="field">
            <span class="label">{F.bodyfat.source}</span>
            <select name="bfSource">
              {bfSources.map((s) => <option value={s.id}>{s.label} (±{fmt.num(s.range)} {F.bodyfat.pp})</option>)}
            </select>
          </label>
        </div>
        <div class="field" data-show-for-source="bia bia8">
          <label class="field">
            <span class="label">{F.bodyfat.readings}</span>
            <span class="unit-input narrow"><input name="readings" inputmode="numeric" placeholder="1" /><span>×</span></span>
            <span class="err" data-error-for="readings"></span>
          </label>
          <p class="hint small muted">{F.bodyfat.readingsHint}</p>
        </div>
      </div>
    </details>

    <!-- 5 Weitere Faktoren -->
    <details class="card group" data-group="factors">
      <summary class="group-head">
        <span class="step-no">5</span>
        <span class="group-title">{F.factors.title}</span>
        <span class="done-dot" data-done="factors" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <label class="check">
          <input type="checkbox" name="athlete" />
          <span set:html={F.factors.athleteHtml} />
        </label>
        <div class="row2">
          <label class="field">
            <span class="label">{F.factors.thyroid}</span>
            <select name="thyroid">
              <option value="">{F.noAnswer}</option>
              {Object.entries(F.factors.thyroidOptions).map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </label>
          <label class="field" data-only="female">
            <span class="label">{F.factors.pregnancy}</span>
            <select name="pregnancy">
              <option value="">{F.noAnswer}</option>
              {Object.entries(F.factors.pregnancyOptions).map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </label>
          <label class="field">
            <span class="label">{F.factors.sleep}</span>
            <span class="unit-input"><input name="sleep" inputmode="decimal" placeholder="7" /><span>{F.factors.hours}</span></span>
            <span class="err" data-error-for="sleepHours"></span>
          </label>
          <label class="field">
            <span class="label">{F.factors.climate}</span>
            <select name="climate">
              <option value="">{F.noAnswer}</option>
              {Object.entries(F.factors.climateOptions).map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </label>
        </div>
        <label class="check">
          <input type="checkbox" name="diet" />
          <span set:html={F.factors.dietHtml} />
        </label>
        <label class="check">
          <input type="checkbox" name="smoker" />
          <span set:html={F.factors.smokerHtml} />
        </label>
      </div>
    </details>

    <!-- 6 Gemessener Ruheumsatz -->
    <details class="card group" data-group="measured">
      <summary class="group-head">
        <span class="step-no">6</span>
        <span class="group-title">{F.measured.title} <span class="badge">★</span></span>
        <span class="gain" data-gain="measured"></span>
        <span class="done-dot" data-done="measured" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <p class="muted small" set:html={F.measured.introHtml} />
        <div class="row2">
          <label class="field">
            <span class="label">{F.measured.kcal}</span>
            <span class="unit-input"><input name="rmr" inputmode="numeric" placeholder="1650" /><span>kcal</span></span>
            <span class="err" data-error-for="rmr"></span>
          </label>
          <label class="field">
            <span class="label">{F.measured.method}</span>
            <select name="rmrMethod">
              <option value="lab">{core.rmrMethods.lab}</option>
              <option value="handheld">{core.rmrMethods.handheld}</option>
            </select>
          </label>
        </div>
        <details class="howto small">
          <summary>{F.measured.conditionsTitle}</summary>
          <ul>{F.measured.conditions.map((c) => <li>{c}</li>)}</ul>
        </details>
        <details class="howto small">
          <summary>{F.measured.whereTitle}</summary>
          <ul>{F.measured.where.map((c) => <li>{c}</li>)}</ul>
        </details>
      </div>
    </details>

    <!-- 7 Aktivität -->
    <details class="card group" data-group="activity">
      <summary class="group-head">
        <span class="step-no">7</span>
        <span class="group-title">{F.activity.title} <span class="muted small">{F.activity.arrow}</span></span>
        <span class="gain" data-gain="activity"></span>
        <span class="done-dot" data-done="activity" aria-hidden="true"></span>
      </summary>
      <div class="group-body">
        <p class="muted small">{F.activity.intro}</p>
        <div class="pal-list" role="radiogroup" aria-label={F.activity.title}>
          <label class="pal"><input type="radio" name="pal" value="" checked /><span><strong>{F.activity.none}</strong></span></label>
          {
            palLevels(locale).map((l) => (
              <label class="pal">
                <input type="radio" name="pal" value={l.id} />
                <span>
                  <strong>{l.label}</strong>
                  <span class="muted small">
                    {l.example} · PAL {fmt.num(l.pal)}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <label class="field">
          <span class="label">{F.activity.sport}</span>
          <select name="sport">
            {sportLevels(locale).map((s) => <option value={s.id}>{s.label}{s.add > 0 ? ` (+${fmt.num(s.add)} PAL)` : ''}</option>)}
          </select>
        </label>
      </div>
    </details>

    <!-- 8 Verlauf -->
    <a class="card group group-link" href="#verlauf" data-group="adaptive">
      <span class="group-head">
        <span class="step-no">8</span>
        <span class="group-title">{F.adaptive.title} <span class="badge">{F.adaptive.badge}</span></span>
        <span class="done-dot" data-done="adaptive" aria-hidden="true"></span>
      </span>
      <span class="group-body small muted" id="adaptive-teaser">{F.adaptive.teaser}</span>
    </a>

    <div class="form-actions">
      <label class="check small">
        <input type="checkbox" name="remember" checked />
        <span>{F.remember}</span>
      </label>
      <button type="button" class="btn ghost small" id="reset-btn">{F.reset}</button>
    </div>
  </form>

  <aside class="result-col" aria-label={t.result.eyebrow}>
    <div class="card result" id="result" aria-live="polite">
      <div class="result-empty" id="result-empty">
        <p class="eyebrow">{t.result.eyebrow}</p>
        <p class="big muted">{t.result.emptyValue}</p>
        <p class="muted">{t.result.empty}</p>
      </div>
      <div class="result-full" id="result-full" hidden>
        <p class="eyebrow">{t.result.eyebrow}</p>
        <p class="big num"><span id="r-value">–</span> <span class="unit">{t.result.perDay}</span></p>
        <p class="range num" id="r-range"></p>

        <div class="meter" aria-hidden="true">
          <div class="meter-track">
            <div class="meter-band ghost" id="m-ghost"></div>
            <div class="meter-band" id="m-band"></div>
            <div class="meter-mark" id="m-mark"></div>
          </div>
          <div class="meter-scale num"><span id="m-min"></span><span id="m-max"></span></div>
        </div>
        <p class="small muted" id="r-narrow"></p>

        <div class="precision">
          <div class="precision-head small">
            <span>{t.result.precision}</span><strong id="r-precision-label"></strong>
          </div>
          <div class="precision-bar"><span id="r-precision-bar"></span></div>
        </div>

        <ul class="stages" id="r-stages"></ul>

        <p class="method small"><span class="muted">{t.result.method}</span> <strong id="r-method"></strong></p>

        <div class="tdee" id="r-tdee" hidden>
          <p class="eyebrow">{t.result.tdee}</p>
          <p class="mid num"><span id="t-value"></span> <span class="unit">{t.result.perDay}</span></p>
          <p class="small muted num" id="t-detail"></p>
        </div>

        <a class="small" href="#erklaerung">{t.result.how}</a>
      </div>
    </div>
  </aside>

  <div class="mini-result" id="mini-result" hidden>
    <a href="#result"><span class="num" id="mini-value"></span> <span class="muted num" id="mini-range"></span></a>
  </div>
</section>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .calc {
      grid-template-columns: 1fr;
    }
  }
  .inputs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .group {
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  fieldset.group {
    border: 1px solid var(--border);
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    font-weight: 650;
    font-size: 1.05rem;
    width: 100%;
  }
  fieldset .group-head {
    float: left;
    padding-bottom: 4px;
  }
  fieldset .group-body {
    clear: both;
  }
  summary.group-head {
    cursor: pointer;
    list-style: none;
  }
  summary.group-head::-webkit-details-marker {
    display: none;
  }
  summary.group-head::after {
    content: '';
    margin-left: 4px;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.2s;
    flex: none;
  }
  details[open] > summary.group-head::after {
    transform: rotate(225deg) translateY(-2px);
  }
  .group-title {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .step-no {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .req,
  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .badge {
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .gain {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-strong);
    white-space: nowrap;
  }
  .gain:empty {
    display: none;
  }
  @media (max-width: 420px) {
    .gain {
      display: none;
    }
  }
  .done-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
    flex: none;
  }
  .done-dot.on {
    background: var(--accent);
  }
  .group-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 4px 18px 18px;
  }
  .group-body > p {
    margin: 0;
  }
  .group-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .group-link:hover {
    border-color: var(--accent);
  }
  .more-intro {
    margin: 6px 4px 0;
  }
  .row2,
  .row3 {
    display: grid;
    gap: 12px;
  }
  .row2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .row3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 560px) {
    .row2,
    .row3 {
      grid-template-columns: 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .field .hint {
    margin: 0;
  }
  .label {
    font-size: 0.88rem;
    font-weight: 600;
  }
  .unit-input {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
  }
  .unit-input.narrow {
    max-width: 160px;
  }
  .unit-input:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .unit-input input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
    padding: 10px 12px;
    outline: none;
  }
  .unit-input > span {
    padding: 0 12px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  select {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    width: 100%;
  }
  .invalid .unit-input {
    border-color: var(--warn);
  }
  .err {
    color: var(--warn);
    font-size: 0.82rem;
    margin: 0;
  }
  .err:empty {
    display: none;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px;
    background: var(--surface-2);
    width: fit-content;
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .seg span {
    display: block;
    padding: 7px 22px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    color: var(--muted);
  }
  .seg input:checked + span {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .seg input:focus-visible + span {
    outline: 3px solid var(--accent);
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    cursor: pointer;
  }
  .check input {
    margin-top: 4px;
    accent-color: var(--accent);
    width: 17px;
    height: 17px;
    flex: none;
  }
  .pal-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pal {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    cursor: pointer;
  }
  .pal:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .pal input {
    margin-top: 5px;
    accent-color: var(--accent);
  }
  .pal > span {
    display: flex;
    flex-direction: column;
  }
  .howto summary {
    cursor: pointer;
    color: var(--accent-strong);
    font-weight: 600;
  }
  .howto ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
  .howto p {
    margin: 8px 0 0;
  }
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 4px;
  }

  /* Caliper */
  .sites {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 12px;
  }
  @media (max-width: 560px) {
    .sites {
      grid-template-columns: 1fr;
    }
  }
  .site-howto {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .caliper-status {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cs-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cs-bar {
    width: 90px;
    flex: none;
    height: 8px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
