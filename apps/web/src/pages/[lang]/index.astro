---
import type { Locale } from '@grundumsatz/core';
import CalculatorPage from '../../components/CalculatorPage.astro';

export function getStaticPaths() {
  return (['en', 'es', 'vi'] as const).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<CalculatorPage locale={locale} />
